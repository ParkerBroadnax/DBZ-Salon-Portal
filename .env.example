# Copy to .env for local runs. Real environment variables take precedence.

# SQLite (no server needed):
DB_DSN=sqlite:var/salon.sqlite
# MySQL / MariaDB:
# DB_DSN=mysql:host=127.0.0.1;port=3306;dbname=salon;charset=utf8mb4
# DB_USER=salon
# DB_PASSWORD=change-me

# Generate with: php -r 'echo password_hash("your-password", PASSWORD_DEFAULT), PHP_EOL;'
# Wrap in single quotes: the hash contains $ characters.
ADMIN_PASSWORD_HASH=

# 1 shows PHP errors in the browser. Never enable in production.
APP_DEBUG=0
